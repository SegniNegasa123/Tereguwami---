# ==============================================================================
# Tereguwami (ተርጓሚ) Monorepo .gitignore
# ==============================================================================

# --- Critical: Raw Video & Consent-Gated Datasets ---
# Raw signer video is strictly access-controlled and must NEVER enter git
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

# Large dataset files & intermediates
data/processed/*.h5
data/processed/*.npz
data/processed/*.tar.gz
data/processed/*.zip

# --- Model Checkpoints & Weights ---
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.tflite
*.ckpt
checkpoints/
weights/

# --- Python Environment & Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# --- Jupyter Notebooks ---
.ipynb_checkpoints
*-checkpoint.ipynb

# --- Node / JavaScript / Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/

# --- Mobile (Android & iOS) ---
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/*.apk
mobile/android/*.aab
mobile/ios/Pods/
mobile/ios/build/
mobile/ios/*.xcworkspace
mobile/ios/*.xcuserdata

# --- Firmware & Embedded ---
firmware/wearable-band/build/
*.hex
*.elf
*.bin
*.map
.pio/

# --- Environment & Secret Keys ---
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.p12

# --- Operating System & IDE ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*~
